{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BatchOperator",
      "Effect": "Allow",
      "Action": [
        "batch:SubmitJob",
        "batch:TerminateJob",
        "batch:CancelJob",
        "batch:DescribeJobs",
        "batch:ListJobs",
        "batch:DescribeJobQueues",
        "batch:DescribeJobDefinitions",
        "batch:DescribeComputeEnvironments"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EcrLogin",
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EcrPushPull",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:DescribeRepositories",
        "ecr:DescribeImages",
        "ecr:ListImages"
      ],
      "Resource": "arn:aws:ecr:us-west-2:213478311378:repository/mapsnap"
    },
    {
      "Sid": "BatchJobLogs",
      "Effect": "Allow",
      "Action": [
        "logs:GetLogEvents",
        "logs:FilterLogEvents",
        "logs:DescribeLogStreams",
        "logs:DescribeLogGroups"
      ],
      "Resource": "arn:aws:logs:us-west-2:213478311378:log-group:/aws/batch/job:*"
    },
    {
      "Sid": "BatchJobDefinitions",
      "Effect": "Allow",
      "Action": [
        "batch:RegisterJobDefinition",
        "batch:DeregisterJobDefinition"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PassTheJobRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::213478311378:role/mapsnap-batch-job",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    }
  ]
}
